---
import { BG_ANIMATIONS, SOUNDS, THEMES } from './player.constants';
import './player.css';
---

<div class="player" data-theme="space" data-bg-motion="galaxy">
  <div class="bg-fx" aria-hidden="true">
    <div class="bg-glow"></div>
    <div class="bg-stars"></div>
  </div>
  <canvas id="stage" aria-label="TinyFingers animation canvas"></canvas>

  <section class="score" aria-label="Live score">
    <p>Keys smashed: <strong id="score-count">0</strong></p>
    <p id="chaos-label">Tiny chaos</p>
  </section>

  <section class="welcome" id="welcome">
    <div class="welcome-actions">
      <button class="start-button" id="start-button">Start smashing!</button>
      <button class="parent-setup-button" id="parent-setup-button" type="button">Parent setup</button>
    </div>
  </section>

  <dialog class="settings" id="settings" aria-labelledby="settings-title">
    <form method="dialog">
      <header>
        <div><p>Grown-ups only</p><h2 id="settings-title">Parent controls</h2></div>
        <button class="close-button" value="close" aria-label="Close parent controls">×</button>
      </header>

      <fieldset>
        <legend>Choose a world</legend>
        <div class="theme-list">
          {THEMES.map((theme, index) => (
            <button type="button" data-theme-choice={theme.id} aria-pressed={index === 0 ? 'true' : 'false'}>{theme.label}</button>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend>Background motion</legend>
        <div class="bg-motion-list">
          {BG_ANIMATIONS.map((bg, index) => (
            <button type="button" data-bg-choice={bg.id} aria-pressed={index === 0 ? 'true' : 'false'}>{bg.label}</button>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend>Sound instrument</legend>
        <div class="sound-list">
          {SOUNDS.map((sound) => (
            <button type="button" data-sound-choice={sound.id} aria-pressed={sound.id === 'mix' ? 'true' : 'false'}>{sound.label}</button>
          ))}
        </div>
      </fieldset>

      <label class="switch-row"><span><strong>Animated background</strong><small>Gentle moving galaxy & theme effects</small></span><input id="bg-animation-toggle" type="checkbox" checked /></label>
      <label class="switch-row"><span><strong>Sound</strong><small>Short, gentle synthesized notes</small></span><input id="sound-toggle" type="checkbox" checked /></label>
      <fieldset class="speech-mode">
        <legend>Letter voice</legend>
        <div class="speech-mode-options">
          <label><input type="radio" name="letter-speech-mode" value="off" /> Off</label>
          <label><input type="radio" name="letter-speech-mode" value="names" checked /> Letter names</label>
          <label><input type="radio" name="letter-speech-mode" value="phonics" /> Phonics sounds</label>
        </div>
        <small>Choose one voice style, or turn letter speech off completely.</small>
      </fieldset>
      <label class="switch-row"><span><strong>Reduced effects</strong><small>Fewer shapes on slower devices</small></span><input id="effects-toggle" type="checkbox" /></label>

      <div class="settings-actions">
        <button type="button" id="reset-score">Reset score</button>
        <button class="done-button" value="close">Back to play</button>
      </div>
    </form>
  </dialog>

  <noscript>TinyFingers needs JavaScript to react to keyboard and touch input.</noscript>
</div>

<script>
  import './player.client';
</script>
